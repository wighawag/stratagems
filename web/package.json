{
  "name": "stratagems-web",
  "version": "0.0.1",
  "description": "Frontend for stratagems.",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@rocketh/export": "^0.19.30",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "abitype": "^1.0.2",
    "eip-1193": "^0.5.0",
    "fuzd-scheduler": "^0.7.0",
    "ipfs-gateway-emulator": "4.2.1-ipfs.2",
    "prettier": "^3.3.1",
    "prettier-plugin-svelte": "^3.2.4",
    "pwag": "0.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.6.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@etherfold/browser": "^0.12.2",
    "@etherfold/graphql": "^0.2.1",
    "@etherfold/processor-entities": "^0.4.1",
    "@metamask/onboarding": "^1.0.1",
    "@noble/ciphers": "^0.5.3",
    "@scure/base": "^1.1.6",
    "@sentry/vite-plugin": "^2.18.0",
    "@types/lodash-es": "^4.17.12",
    "@zerodevx/svelte-json-view": "^1.0.9",
    "driver.js": "^1.3.1",
    "ethereum-tx-observer": "^0.0.5",
    "focus-trap": "^7.5.4",
    "fuzd-client": "^0.7.1",
    "immer": "^10.1.1",
    "lodash-es": "^4.17.21",
    "lucide-svelte": "^0.394.0",
    "lz-string": "^1.5.0",
    "missiv-client": "^0.0.13",
    "named-logs": "^0.2.4",
    "pretty-ms": "^9.0.0",
    "radiate": "^0.0.2",
    "stratagems-common": "workspace:*",
    "stratagems-indexer": "workspace:*",
    "svelte-headless-table": "^0.18.2",
    "svelte-portal": "^2.2.1",
    "theme-change": "^2.5.0",
    "tippy.js": "^6.3.7",
    "twgl.js": "^5.5.4",
    "viem": "^2.13.7",
    "web3-connection": "^0.1.39",
    "web3-connection-viem": "^0.3.0"
  },
  "scripts": {
    "prepare": "pwag static/icon.png src/web-config.json",
    "dev": "echo 'waiting for src/data/contracts.ts and the processor bundle...'; wait-on src/data/contracts.ts ../indexer/dist/processor.bundle.js && node scripts/processor-bundle.js && ldenv vite dev",
    "build": "pnpm run prepare && node scripts/processor-bundle.js && ldenv vite build",
    "preview": "ldenv vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "svelte-check": "svelte-check",
    "serve": "ipfs-emulator --only -d build -p 8080",
    "verify:alpha1": "playwright test -c verify/playwright.config.ts"
  }
}
