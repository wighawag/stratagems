{
  "name": "stratagems-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./deploy/*": "./dist/deploy/*",
    "./rocketh/*": "./dist/rocketh/*",
    "./artifacts/*": "./dist/generated/artifacts/*",
    "./abis/*": "./dist/generated/abis/*",
    "./deployments/*": "./deployments/*",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@etherplay/delegation": "^0.1.1"
  },
  "devDependencies": {
    "@etherfold/browser": "^0.13.0",
    "@etherfold/graphql": "^0.2.2",
    "@etherfold/processor-entities": "^0.4.2",
    "@etherfold/state-store-sqlite": "^0.5.1",
    "@libsql/client": "^0.17.4",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@openzeppelin/contracts": "^5.0.2",
    "@rocketh/deploy": "^0.22.2",
    "@rocketh/doc": "^0.19.30",
    "@rocketh/export": "^0.20.2",
    "@rocketh/node": "^0.22.1",
    "@rocketh/proxy": "^0.21.2",
    "@rocketh/read-execute": "^0.22.1",
    "@rocketh/router": "^0.20.2",
    "@rocketh/signer": "^0.20.1",
    "@rocketh/verifier": "^0.19.30",
    "@rocketh/viem": "^0.20.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "abitype": "^1.3.0",
    "as-soon": "^0.0.9",
    "eip-1193": "^0.7.4",
    "ethereum-contracts-test-suite": "^0.2.5",
    "fs-extra": "^11.2.0",
    "hardhat": "^3.18.0",
    "hardhat-deploy": "^2.1.1",
    "hardhat-external-artifacts": "^0.0.6",
    "ldenv": "^0.3.10",
    "prettier": "^3.3.1",
    "prettier-plugin-solidity": "^1.3.1",
    "prompts": "^2.4.2",
    "remote-sql-libsql": "^0.0.7",
    "rocketh": "^0.25.0",
    "earl": "^2.0.0",
    "solidity-kit": "^0.5.7",
    "solidity-proxy": "^0.4.0",
    "stratagems-common": "workspace:*",
    "stratagems-indexer": "workspace:*",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "viem": "^2.57.1",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "prepare": "pnpm compile && tsc",
    "_prepare": "`tsc` is part of prepare because `dist` is a BUILD INPUT for the web workspace, not just a publish artifact: web/src/lib/offline.ts imports this package's deploy scripts and rocketh config to run them in the browser (the offline world), and every one of those export paths resolves into dist. Without it a fresh clone or worktree fails `web check` with module-resolution errors that say nothing about this package. The template's contracts package does the same, for the same reason.",
    "docgen": "ldenv -m localhost pnpm rocketh-doc -e @@MODE --except-suffix _Implementation,_Proxy,_Router,_Route -t docs_templates/{{contracts}}.hbs @@",
    "local_node": "hardhat --network node node --hostname 0.0.0.0",
    "compile": "hardhat compile",
    "compile:watch": "as-soon -w src pnpm compile",
    "execute": "ldenv -n HARDHAT_NETWORK -m localhost tsx @@",
    "fork:execute": "ldenv -m localhost tsx @=HARDHAT_FORK=@@MODE @@",
    "deploy": "pnpm compile && ldenv hardhat --network @@MODE deploy @@",
    "fork:deploy": "pnpm compile && ldenv hardhat @=HARDHAT_FORK=@@MODE --network @@MODE deploy @@",
    "deploy:dev": "ldenv hardhat --network @@MODE deploy --skip-prompts @@",
    "deploy:watch": "as-soon -w generated -w deploy pnpm run deploy:dev",
    "verify": "ldenv rocketh-verify -e @@MODE @@",
    "test": "pnpm compile && hardhat --network test test nodejs --no-compile && vitest run",
    "_test": "two runners on purpose (step 10b, P6): test/js is the commit-reveal base's suite, byte-identical to the stem's and written for Hardhat's node test runner; stratagems' own suites stay on vitest, which excludes test/js.",
    "export": "rocketh-export",
    "export-script-data": "ldenv rocketh-export -e @@MODE --ts ./scripts/data/contracts.ts @@",
    "start": "zellij --layout zellij.kdl a $npm_package_name || zellij --layout zellij.kdl -s $npm_package_name",
    "stop": "zellij kill-session $npm_package_name",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "_typecheck:scripts": "scripts/data/*.ts import scripts/data/contracts.ts, which `pnpm export-script-data <mode>` writes: run that first"
  }
}
