    "pretty-ms": "^9.0.0",
    "radiate": "^0.3.2",
    "radiate-legacy": "npm:radiate@^0.0.2",
    "stratagems-common": "workspace:*",
    "stratagems-indexer": "workspace:*",
    "svelte-headless-table": "^0.18.2",
    "svelte-portal": "^2.2.1",
    "theme-change": "^2.5.0",
    "tippy.js": "^6.3.7",
