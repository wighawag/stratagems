{
  "name": "stratagems-indexer",
  "version": "0.1.0",
  "description": "stratagems processor (an etherfold EntityProcessor), its indexing source, and the GraphQL questions the web app asks of the state",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@etherfold/processor-entities": "^0.4.0",
    "stratagems-common": "workspace:*"
  },
  "devDependencies": {
    "@etherfold/browser": "^0.12.1",
    "@etherfold/graphql": "^0.2.0",
    "@types/node": "^20.14.2",
    "esbuild": "0.28.2",
    "etherfold": "0.10.1",
    "fake-indexeddb": "^6.2.5",
    "ldenv": "^0.3.10",
    "prettier": "^3.3.1",
    "tsup": "^8.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "---- BUILD: the library (types, the source, the queries) that web/ and contracts/ import, then the processor BUNDLE etherfold runs. The bundle's bytes are its identity (etherfold ADR-0086), so esbuild is pinned to an exact version and this command must not drift: a different bundler version or flag is a different generation, and a published snapshot is only found by a tab running the same bytes ----": "",
    "build": "tsup src/index.ts --dts --format esm && pnpm build:bundle",
    "build:bundle": "esbuild ./src/processor.bundle.ts --bundle --format=esm --minify --outfile=dist/processor.bundle.js",
    "dev": "echo 'waiting for src/contracts.ts...'; wait-on src/contracts.ts && tsup src/index.ts --dts --format esm --watch --onSuccess 'pnpm build:bundle'",
    "---- INDEX: fold a deployment with `etherfold build` into data/<mode>.db and publish it (history none, no seed) into ../web/static/indexed-states/<mode>, which web/ serves and starts from ----": "",
    "index": "tsx scripts/index.ts",
    "---- the read tier over what `index` folded: GraphQL at /graphql (etherfold serve) ----": "",
    "serve": "ldenv etherfold serve --db file:./data/@@MODE.db @@",
    "compare:alpha1": "tsx oracle/2026-09-29-alpha1/compare.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  }
}
