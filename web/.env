# this let ldenv know to load the parent foler .env too (the child folder's vars takes precedence though)
ENV_ROOT_FOLDER=..

# only used for development, this does not replace PUBLIC_ETH_NODE_URI_LOCALHOST
# Use it only for dev-related queries
PUBLIC_DEV_NODE_URI=http://localhost:8545

# This set a fallback node (centralised node) to let the app get read access to the blockchain 
# Disabled by default: User need a wallet to read state
PUBLIC_ETH_NODE_URI=
PUBLIC_ETH_NODE_URI_LOCALHOST=
# for localhost, you can also set it to be the same as PUBLIC_DEV_NODE_URI
# PUBLIC_ETH_NODE_URI_LOCALHOST=${PUBLIC_DEV_NODE_URI}

# Can specify a block time for localhost
PUBLIC_LOCALHOST_BLOCK_TIME=${BLOCK_TIME}

PUBLIC_SYNC_URI=http://127.0.0.1:34001/

PUBLIC_FUZD_URI=http://127.0.0.1:34002
PUBLIC_SNAPSHOT_URI=https://snapshots.stratagems.world
PUBLIC_MISSIV_URI=http://127.0.0.1:34003/api

# ---------------------------------------------------------------------------
# from template-commit-reveal: what its framework (web/src/lib/{core,context,game,ui,...})
# reads through $env/static/public. stratagems' own app above does not read these;
# they matter once the port mounts the template's app context (step 6).
PUBLIC_NODE_URL=
# The RPC url handed to the user's WALLET (via wallet_addEthereumChain), which
# is not necessarily the one the app itself uses. Set this whenever the wallet
# is not expected to already know the chain: without it the wallet cannot be
# told how to reach the chain and switching fails with "Unrecognized chain ID".
# It is never defaulted from PUBLIC_NODE_URL, since that one may be a private or
# key-bearing endpoint, and this value goes to every user's wallet.
PUBLIC_CHAIN_INFO_NODE_URL=
# ENS RPC URL. Set to enable ENS lookups (default below uses viem's mainnet
# default, https://ethereum.reth.rs/rpc); empty disables ENS entirely.
PUBLIC_ENS_NODE_URL="https://ethereum.reth.rs/rpc"
PUBLIC_EXPLORER_BLOCK_INDEX_ENABLED=
PUBLIC_USE_INTERNAL_EXPLORER=true
PUBLIC_FAUCET_LINK=
PUBLIC_FAUCET_API=
PUBLIC_USE_BURNER_WALLET=
# Accounts the burner wallet may impersonate, comma-separated. Local/dev only:
# it is what lets a developer act as an address they do not hold a key for.
# Empty here on purpose, since the burner wallet is off by default; the local
# setup declares its own (see .env.localhost).
#
# WORTH KNOWING ON THIS BRANCH: this app signs in, and signing in needs a
# signature, which an impersonated account has no key to produce. So one can
# send through the node but can never get past 'WalletConnected'. They are still
# offered locally (the burner lists its own generated accounts alongside them,
# and those CAN sign in), but picking an impersonated one stalls the connect
# flow rather than failing, which is worth recognising before debugging it.
PUBLIC_IMPERSONATE_ADDRESSES=
# Hosted sign-in service URL. When set, email and social sign-in are offered
# alongside wallets. When empty, only built-in wallets can authenticate - which
# is a complete configuration, not a degraded one: the app still signs in and
# still derives a local signer, with no backend involved.
#
# It does NOT decide whether the app signs in at all. That is TARGET_STEP in
# core/connection/mode.ts, which is code rather than env because it is a
# decision about what the app IS.
PUBLIC_WALLET_HOST=
# Number of days to retain operations (even if not complete) before deletion (default: 7)
PUBLIC_OPERATION_RETENTION_DAYS=
# Set to true to register the service worker in dev mode (default: off, so HMR
# is not intercepted by the SW cache). Useful for developing the SW itself.
PUBLIC_ENABLE_SW_IN_DEV=

