{
  "name": "stratagems-web",
  "version": "0.0.1",
  "description": "Frontend for stratagems.",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@etherkit/burner-wallet": "^0.2.2",
    "@etherkit/tx-observer": "0.3.0",
    "@etherkit/viem-tx-tracker": "0.2.1",
    "@etherplay/connect": "^0.17.0",
    "@etherplay/wallet-connector": "^0.2.1",
    "@etherplay/wallet-connector-ethereum": "^0.4.0",
    "@fuzd/client": "^0.12.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@observator/svelte": "^0.3.1",
    "@playwright/test": "^1.62.1",
    "@rocketh/web": "^0.19.31",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^4.1.11",
    "bits-ui": "^2.18.2",
    "clsx": "^2.1.1",
    "eip-1193": "^0.7.4",
    "fake-indexeddb": "^6.2.5",
    "faucet-client": "^0.1.0",
    "ipfs-gateway-emulator": "^5.1.0",
    "json-stable-stringify": "^1.3.0",
    "ldenv": "^0.6.0",
    "mode-watcher": "^1.1.0",
    "observator": "^0.3.0",
    "pixi.js": "^8.19.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pwag": "0.3.0",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "synqable": "^0.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tlock-js": "^0.9.0",
    "tseep": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^3.0.0",
    "wait-on": "^7.2.0",
    "webevm": "^0.9.1"
  },
  "dependencies": {
    "@etherfold/browser": "^0.13.0",
    "@etherfold/graphql": "^0.2.2",
    "@etherfold/processor-entities": "^0.4.2",
    "@etherfold/state-store": "^0.5.1",
    "@sentry/vite-plugin": "^2.18.0",
    "named-logs": "^0.4.1",
    "radiate": "^0.3.2",
    "stratagems-common": "workspace:*",
    "stratagems-contracts": "workspace:*",
    "stratagems-indexer": "workspace:*",
    "viem": "^2.55.19"
  },
  "scripts": {
    "prepare": "pwag static/icon.png src/web-config.json",
    "dev": "echo 'waiting for src/lib/deployments.ts and the processor bundle...'; wait-on src/lib/deployments.ts ../indexer/dist/processor.bundle.js && node scripts/processor-bundle.js && ldenv vite dev",
    "build": "pnpm run prepare && node scripts/processor-bundle.js && ldenv vite build @@",
    "preview": "ldenv vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "svelte-check": "svelte-check",
    "serve": "ipfs-emulator --only -d build -p 8080",
    "test": "npm run test:unit",
    "test:e2e": "bash ../scripts/run-e2e-tests.sh",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:unit": "vitest run --project server && vitest run --project client",
    "test:unit:watch": "vitest"
  }
}
